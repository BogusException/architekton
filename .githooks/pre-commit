#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/private-paths.sh"

# ── 1. Block private paths ────────────────────────────────────────────────────
while IFS= read -r -d '' path; do
    guard_path "$path" || exit 1
done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

# ── 2. Secret pattern scan ────────────────────────────────────────────────────
while IFS= read -r -d '' path; do
    [[ "$path" == *.png || "$path" == *.jpg || "$path" == *.gif || "$path" == *.ico ]] && continue
    [[ "$path" == .githooks/* || "$path" == .claude/hooks/* ]] && continue
    content="$(git show ":$path" 2>/dev/null)" || continue
    hit=""
    echo "$content" | grep -qE 'sk-[A-Za-z0-9]{20}'          && hit="Anthropic/OpenAI key pattern"
    echo "$content" | grep -qE 'AKIA[0-9A-Z]{16}'             && hit="AWS access key"
    echo "$content" | grep -qE 'ghp_[A-Za-z0-9]{36}'          && hit="GitHub personal access token"
    echo "$content" | grep -qF -- '-----BEGIN PRIVATE KEY'        && hit="private key block"
    echo "$content" | grep -qF -- '-----BEGIN RSA PRIVATE KEY'    && hit="RSA private key block"
    echo "$content" | grep -qF -- '-----BEGIN OPENSSH PRIVATE KEY' && hit="OpenSSH private key block"
    echo "$content" | grep -qiE 'password\s*=\s*['\''"][^'\''"]{4}' && hit="hardcoded password"
    if [[ -n "$hit" ]]; then
        echo "pre-commit: $hit detected in $path -- commit blocked." >&2
        exit 1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

# ── 3. Python syntax check ────────────────────────────────────────────────────
python_bin="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
if [[ -n "$python_bin" ]]; then
    while IFS= read -r -d '' path; do
        [[ "$path" == *.py ]] || continue
        tmpfile="$(mktemp --suffix=.py)"
        git show ":$path" > "$tmpfile"
        if ! "$python_bin" -m py_compile "$tmpfile" 2>/tmp/py_compile_err; then
            rm -f "$tmpfile"
            echo "pre-commit: syntax error in $path:" >&2
            sed "s|$tmpfile|$path|g" /tmp/py_compile_err >&2
            exit 1
        fi
        rm -f "$tmpfile"
    done < <(git diff --cached --name-only --diff-filter=ACMRT -z)
fi
