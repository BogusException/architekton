coverage.xml

# Environment & secrets
.env
.env.*
!.env.example
secrets/

# Benchmark run output (local only -- share manifest.json and *.json files manually)
tests/benchmarks/results/*/
!tests/benchmarks/results/20261127_215806/
!tests/benchmarks/results/20261127_221126/
!tests/benchmarks/results/20261127_225643/

# Loose output files written to results root (plain-mode and analysis artifacts)
tests/benchmarks/results/*.txt

# Benchmark timing history and baseline cache (local only)
tests/benchmarks/results/.timing_history.json

# Logs & runtime
*.log
logs/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Claude Code responses (never commit content)
responses/

# Private filesystem backups at any depth
**/backups/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# Agent-local state and credentials
.claude/settings.local.json
.codex/auth.json
.codex/sessions/
.codex/log/

# mkproj project identity (per-project, not for version control)
.mkproj

# Publish tooling (content-sensitive, not for version control)
.publish-blocklist

# Private keys and credential containers
*.pem
*.key
*.p12
*.pfx
